isioni":[]},{"id":"fermo","nome":"Fermo (liquidita)","stile":"Confronto","mentalita":"Tiene tutto in liquidita fruttifera. Il rischio zero come confronto.","tipo":"controllo","cash":0,"versato":10000,"pos":{"LU0290358497":66.24317012360088},"pesi":{"monetario":100},"storia":[["2026-11-18",9990,1],["2026-11-19",9990,1]],"ops":[{"d":"2026-11-18","mosse":[{"g":"monetario","da":0,"a":100}],"costo":10}],"motivo":"","conv":0,"decisioni":[]}],"analisti":[{"id":"usa","nome":"Ugo","reparto":"Stati Uniti","focus":"grandi aziende USA, tecnologia, Federal Reserve, tassi, utili; guarda anche cosa comprano e vendono i grandi fondi americani (dati pubblici SEC)","scheda":{"data":"2026-11-19","sintesi":"Il mercato azionario statunitense evidenzia una fase di debolezza, con il Nasdaq in flessione del 5,0% nell'ultimo mese e il settore dei semiconduttori in calo del 10,4%. I verbali della Federal Reserve e le dichiarazioni dei suoi membri prefigurano possibili nuovi rialzi dei tassi per contrastare un'inflazione ancora superiore al target del 2%. Pesano le forti tensioni su Nvidia, crollata del 29,5% in un mese a seguito anche dell'uscita del CEO Jensen Huang. Nel frattempo, i grandi fondi istituzionali aumentano l'esposizione su Microsoft e riducono la presenza su Alphabet.","clima":-1,"rischi":["Istituzione di rialzi dei tassi più aggressivi da parte della Fed per contenere un'inflazione ostinata sopra il target del 2%","Aumento dell'instabilità nel settore dei semiconduttori legato alle incertezze di governance in Nvidia e ai vincoli sull'export"],"idee":[{"gruppo":"az-nvda","dir":"giu","fiducia":4,"perche":"Il titolo segna un calo del 29,5% nell'ultimo mese e del 31,3% a tre mesi, risentendo dell'av avvicendamento ai vertici societari e delle incertezze sul mercato tecnologico.","fonti":[{"testata":"MarketWatch","titolo":"&#x2018;Nvidia&#x2019;s turmoil has me spooked&#x2019;: Should I sell my stocks and buy real estate &#x2014; or ride out the storm?","url":"https://www.marketwatch.com/story/nvidia-spooked-me-should-i-sell-my-stocks-or-ride-out-the-market-turmoil-560583c6?mod=mw_rss_topstories","data":"2026-11-19"},{"testata":"MarketWatch","titolo":"Nvidia&#x2019;s booming demand is &#x2018;hard to ignore,&#x2019; but these four questions loom over the stock","url":"https://www.marketwatch.com/story/what-wall-street-analysts-are-now-saying-after-nvidias-beat-and-raise-quarter-9311c85d?mod=mw_rss_topstories","data":"2026-11-18"},{"testata":"TechCrunch","titolo":"Elon Musk says ousting Jensen Huang is like ‘kicking Michael Jordan off your team’","url":"https://techcrunch.com/2026/11/18/elon-musk-says-ousting-jensen-huang-is-like-kicking-michael-jordan-off-your-team/","data":"2026-11-18"},{"testata":"TechCrunch","titolo":"Microsoft CEO Satya Nadella remains confident in Nvidia after Huang’s exit","url":"https://techcrunch.com/2026/11/18/microsoft-ceo-satya-nadella-remains-confident-in-nvidia-after-huangs-exit/","data":"2026-11-18"}]},{"gruppo":"az-msft","dir":"su","fiducia":3,"perche":"Microsoft mantiene un rendimento a 3 mesi del +5,5% ed è stato il titolo più comprato dai grandi fondi nell'ultimo trimestre, con un saldo netto positivo di 4372 milioni di dollari.","fonti":[{"testata":"TechCrunch","titolo":"Microsoft CEO Satya Nadella explains why he asked 60K employees to quit","url":"https://techcrunch.com/2026/11/18/microsoft-ceo-satya-nadella-explains-why-he-asked-60k-employees-to-quit/","data":"2026-11-19"},{"testata":"TechCrunch","titolo":"Microsoft CEO Satya Nadella remains confident in Nvidia after Huang’s exit","url":"https://techcrunch.com/2026/11/18/microsoft-ceo-satya-nadella-remains-confident-in-nvidia-after-huangs-exit/","data":"2026-11-18"}]}],"limiti":"Non si conoscono gli esiti del vertice trilaterale tra Trump, Xi e Putin né l'impatto economico effettivo dei buy-out proposti da Microsoft a 60.000 dipendenti.","nTitoli":28},"schede":2,"errori":0},{"id":"europa","nome":"Elisa","reparto":"Europa","focus":"economia e borse europee, BCE, Italia, energia, banche, industria, difesa","scheda":{"data":"2026-11-19","sintesi":"I mercati azionari europei registrano cali recenti, con l'indice generale dell'area euro in calo del 3,9% nell'ultima settimana e del 4,6% negli ultimi tre mesi. La Banca Centrale Europea evidenzia rischi per la stabilità finanziaria legati a valutazioni dell'intelligenza artificiale, squilibri fiscali e tensioni geoeconomiche. Nel frattempo, i settori difensivi e tecnologici mostrano forti correzioni a breve termine, mentre i servizi di pubblica utilità tengono meglio con un progresso del 4,5% nell'ultimo mese.","clima":-1,"rischi":["Tensioni geoeconomiche e rischi per la stabilità finanziaria segnalati dalla BCE.","Forte calo dei titoli legati alla difesa e alla tecnologia nell'ultima settimana.","Squilibri fiscali e normative complesse in Europa."],"idee":[{"gruppo":"utility","dir":"su","fiducia":3,"perche":"Il settore mostra resilienza con un incremento del 4,5% nell'ultimo mese e del 5,7% negli ultimi tre mesi.","fonti":[]},{"gruppo":"difesa","dir":"giu","fiducia":4,"perche":"Il comparto registra un calo marcato del 5,2% nell'ultima settimana e del 17,6% negli ultimi tre mesi.","fonti":[]}],"limiti":"Non conosco gli sviluppi futuri delle decisioni politiche internazionali e l'impatto esatto delle inchieste bancarie sui mercati nei prossimi mesi.","nTitoli":28},"schede":1,"errori":1},{"id":"asia","nome":"Chiara","reparto":"Cina e Asia","focus":"Cina, Giappone, Corea, Taiwan, India; politica economica di Pechino, esportazioni, semiconduttori asiatici","scheda":{"data":"2026-11-19","sintesi":"Il reparto asiatico e cinese attraversa una fase di marcata debolezza, accentuata da restrizioni USA sui chip avanzati che colpiscono i centri dati nel sud-est asiatico e pesano sui colossi tecnologici come Alibaba e Tencent. La Cina fronteggia inoltre pressioni fiscali e timori di fuga di capitali, mentre i semiconduttori registrano cali importanti (-10,4% a un mese). L'India mostra segnali di ripresa a breve ma affronta test legati all'inflazione, mentre il Giappone evidenzia resilienza con esportazioni record di chip.","clima":-1,"rischi":["Nuove restrizioni USA sui chip avanzati e sull'accesso alla potenza di calcolo nel sud-est asiatico a supporto della domanda cinese.","Stretta fiscale interna in Cina e rischi di fuga di capitali verso gli Stati Uniti da Hong Kong.","Inflazione in aumento da 12 mesi in India che minaccia la crescita e gli afflussi di capitali esteri."],"idee":[{"gruppo":"az-alibaba","dir":"giu","fiducia":4,"perche":"Il titolo registra cali consistenti con un passivo del 30,5% a tre mesi e del 40,9% da inizio anno, penalizzato da un contesto di stretta fiscale e tensioni regolatorie.","fonti":[{"testata":"South China Morning Post","titolo":"China’s tax crackdown could spark capital flight from Hong Kong to US: analysts","url":"https://www.scmp.com/business/china-business/article/3374910/chinas-tax-crackdown-could-spark-capital-flight-hong-kong-us-analysts","data":"2026-11-19"}]},{"gruppo":"semis","dir":"giu","fiducia":3,"perche":"I semiconduttori segnano -10,4% a un mese e -19,3% a tre mesi, frenati dalle nuove regole USA sui chip in Asia e dai costi per l'IA.","fonti":[{"testata":"CNBC Asia","titolo":"Southeast Asia’s data center boom leaned on Chinese demand. New U.S. rules put that pipeline at risk","url":"https://www.cnbc.com/2026/11/18/nvidia-us-ai-chip-export-controls-data-centers-.html","data":"2026-11-18"},{"testata":"BBC Asia","titolo":"How new US chip restrictions on South East Asia will hit China","url":"https://www.bbc.co.uk/news/articles/cwq6e2qgvmlgo?at_medium=RSS&at_campaign=rss","data":"2026-11-17"}]}],"limiti":"Non conosco l'evoluzione precisa degli incontri politici di alto livello tra Stati Uniti, Cina e Russia previsti in sede APEC e i loro risvolti pratici immediati sui mercati.","nTitoli":28},"schede":2,"errori":0},{"id":"emergenti","nome":"Amadou","reparto":"Mercati emergenti","focus":"America Latina, Africa, Medio Oriente, India e altri emergenti; valute, debito, politica, materie prime","scheda":{"data":"2026-11-19","sintesi":"Il mercato azionario dei mercati emergenti mostra una fase di debolezza recente con un calo del 2,1% nell'ultima settimana e del 5,6% nell'ultimo mese, sebbene mantenga un rialzo del 13,5% da inizio anno. La situazione è particolarmente negativa per il Brasile, che crolla del 24,7% nell'ultimo mese, e per l'Asia emergente in calo del 6,3% nell'ultima settimana. In controtendenza l'India, che registra un progresso del 1,4% settimanale e del 12,5% mensile.","clima":-1,"rischi":["Forte volatilità e cali pronunciati in alcune aree geografiche, guidati dal crollo mensile del Brasile (-24,7%).","Flessione generalizzata delle materie prime con panieri in calo dell'8,5% in un mese e società minerarie dell'oro in forte perdita (-11,5% nell'ultima settimana)."],"idee":[{"gruppo":"india","dir":"su","fiducia":3,"perche":"L'India mostra una buona tenuta con un guadagno del 1,4% nell'ultima settimana e del 12,5% nell'ultimo mese, confermandosi in controtendenza rispetto alla debolezza generale degli emergenti.","fonti":[]},{"gruppo":"brasile","dir":"giu","fiducia":4,"perche":"Il Brasile registra un pesantissimo calo del 24,7% nell'ultimo mese e un -2,5% nell'ultima settimana, evidenziando una forte pressione ribassista.","fonti":[]}],"limiti":"Non conosco i dettagli finanziari specifici dei singoli settori industriali locali né l'impatto economico esatto degli eventi politici riportati nelle notizie.","nTitoli":28},"schede":2,"errori":0},{"id":"risorse","nome":"Rocco","reparto":"Risorse e materie prime","focus":"petrolio, gas, oro, metalli, energia pulita, scorte e prezzi delle materie prime","scheda":{"data":"2026-11-19","sintesi":"Il comparto energetico continua a risentire delle tensioni geopolitiche e dei conflitti in Medio Oriente, inclusi gli attacchi informatici e la crisi nello Stretto di Hormuz che mantengono elevati i prezzi di gas e petrolio. Nel frattempo, Eni e le utility registrano performance positive da inizio anno, mentre l'oro e le relative società minerarie segnano flessioni marcate nell'ultima settimana e mese. L'energia pulita mostra anch'essa un andamento negativo a breve termine.","clima":-1,"rischi":["Instabilità geopolitica persistente in Medio Oriente e tensioni nello Stretto di Hormuz","Attacchi informatici e minacce alle infrastrutture energetiche critiche in Europa","Volatilità dei prezzi delle materie prime e impatti inflazionistici sui consumatori"],"idee":[{"gruppo":"utility","dir":"su","fiducia":3,"perche":"Il settore registra un incremento mensile del 4,5% e trimestrale del 5,7%, sostenuto anche dalla forte domanda energetica.","fonti":[]},{"gruppo":"az-eni","dir":"su","fiducia":3,"perche":"Eni mostra una solida crescita del 54,1% da inizio anno e un rialzo del 3,1% negli ultimi tre mesi.","fonti":[]},{"gruppo":"oro","dir":"giu","fiducia":2,"perche":"L'oro registra cali consistenti sia su base settimanale (-5,4%) che mensile (-8,1%).","fonti":[]}],"limiti":"Non conosco l'evoluzione futura delle tensioni nello Stretto di Hormuz né l'impatto a lungo termine delle politiche energetiche globali.","nTitoli":28},"schede":2,"errori":0},{"id":"frontiere","nome":"Fabio","reparto":"Cripto e frontiere","focus":"criptovalute, regole e ETF cripto, intelligenza artificiale, chip, difesa e tecnologie di frontiera ad alto rischio","scheda":{"data":"2026-11-19","sintesi":"Il comparto cripto e delle tecnologie di frontiera affronta forti ribassi, con Bitcoin in calo del 15,2% nell'ultima settimana e del 23,1% in un mese, mentre Ether perde il 25,9% mensile. Emergono forti pressioni normative e problemi di sicurezza legati a hack milionari, come i provvedimenti legali e i congelamenti di asset per Binance. Nel frattempo, i miner come MARA continuano a vendere Bitcoin e ad accumulare debito per finanziare la transizione verso le infrastrutture per l'intelligenza artificiale.","clima":-2,"rischi":[